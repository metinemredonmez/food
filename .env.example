# Mantarhane prod ayarları — bu dosyayı ".env" olarak kopyalayıp doldurun:
#   cp .env.example .env
# Docker'da bu dosya GEREKMEZ (değişkenler docker-compose.yml'den gelir).
# .env yalnızca eksik değişkenleri doldurur; ortam değişkenleri her zaman önceliklidir.

APP_ENV=prod

# --- Veritabanı (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mantarhane
DB_USER=mantarhane
DB_PASS=BURAYA_GUCLU_SIFRE

# --- Redis (opsiyonel — yoksa site yine çalışır, sadece form hız limiti devre dışı kalır) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- E-posta (SMTP) ---
# Turhost / hosting SMTP bilgileriniz. Genelde: mail.alanadiniz.com, port 587, SMTP_SECURE=tls
SMTP_HOST=mail.mantarhane.co
SMTP_PORT=587
SMTP_USER=no-reply@mantarhane.co
SMTP_PASS=BURAYA_EPOSTA_SIFRESI
SMTP_SECURE=tls

# --- Yönetim paneli ---
ADMIN_PASSWORD=BURAYA_ADMIN_SIFRESI
